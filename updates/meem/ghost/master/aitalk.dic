EndMikireTalk
{
	 if sleeping == 1
	{
		if sitting == 0
		{
			"\s[97]"
		}
		--
		"Mmf... \w8hnn...? \w8Zzz...\e"
	}
	else
	{
		"\0\s[1]\i[ch]What\i[a]\![anim,clear,ch] a cu\i[o]\![anim,clear,a]rious s\i[ch]\![anim,clear,o]ensat\i[a]\![anim,clear,ch]ion..\i[ch]\![anim,clear,a].\e"
	}
 }


//**** OnSurfaceRestore *****************************************************************
//*********************Advanced User Info*******************************
//You can put if statements in OnSurfaceRestore to make exceptions for certain poses, or to make sure that once they're in a certain pose, they stay in that pose. For example, if you turn my Hunter and Smoker ghost into eggplants, there's a check for the their eggplant pose numbers to make sure they STAY eggplants when OnSurfaceRestore is called.
//You can also use OnSurfaceRestore to clean up things that might be left on the screen, primarily from using p[number]\s[] to call up other objects or characters. Just make sure to add a p[number]\s[-1] to OnSurfaceRestore, and that should get rid of it each time the ghost cleans itself up.
//***********************************************************************

OnSurfaceRestore
{
	//if he is asleepb
 	if sleeping == 1
	{
		sleeping = 1
		if sitting == 1
		{
			"\s[98]"
		}
		elseif sitting == 2
		{
			"\s[99]"
		}
		else
		{
			"\s[96]"
		}
 	}
	//if he has the clipboard out. probably a more efficient way to do this but whatever
	else
	{
		if reference0 == 72
		{
			"\0\s[boardlooky]\e"
		}
		elseif (reference0 >= 70 && reference0 <= 72) || reference0 == 170 || reference0 == 171 || (reference0 >= 570 && reference0 <= 573) || (reference0 >= 670 && reference0 <= 673)
		{
			if RAND(10) >= 3
			{
				"\0\s[board]\e"
				"\0\s[72]\e"
			}
			else
			{
				"\0\s[0]\e"
				"\0\s[60]\i[base]\e"
				"\0\s[61]\i[base]\e"
				"\0\s[160]\i[base]\e"
				"\0\s[161]\i[base]\e"
				"\0\s[90]\e"
			}
		}
		else
		{
			"\0\s[0]\e"
			"\0\s[60]\i[base]\e"
			"\0\s[61]\i[base]\e"
			"\0\s[160]\i[base]\e"
			"\0\s[161]\i[base]\e"
			"\0\s[90]\e"
			if RAND(10) >= 8
			{
				"\0\s[board]\e"
			}
		}
	}
}

OnKeyPress
{
	if reference0 == "t"
	{
	OnAiTalk
	}
	elseif reference0 == "r"
	{
	OnLastTalk
	}
	elseif reference0 == "f1"
	{
	"\![open,readme]"
	}
}

