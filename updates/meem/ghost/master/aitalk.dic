			"\0\s[60]\i[base]Hm. \w5\i[au]\![anim,clear,base]I bel\i[ch]\![anim,clear,au]ieve \i[a]\![anim,clear,ch]I was in \i[ch]\![anim,clear,a]charg\i[au]\![anim,clear,ch]e of \i[ch]\![anim,clear,au]break\i[a]\![anim,clear,ch]fast toda\i[ch]\![anim,clear,a]y... \w5\s[251]\i[a]ach,\i[ch]\![anim,clear,a] the\i[a]\![anim,clear,ch]y will\i[ch]\![anim,clear,a] make\i[o]\![anim,clear,ch] do.\i[ch]\![anim,clear,o]\e"
