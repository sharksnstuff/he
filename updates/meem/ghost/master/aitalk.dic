			"\0\s[190]\i[base]\f[italic,true](He lets out a little sigh. \w5He doesn't seem as tense as he was before.)\e"
		}
		if passhour == 1
		{
			"\0\s[60]\i[a]It's \i[ch]\![anim,clear,a]been \i[a]\![anim,clear,ch]an ho\i[au]\![anim,clear,a]ur no\i[o]\![anim,clear,au]w, I \i[a]\![anim,clear,o]think\i[ch]\![anim,clear,a]... \w5\s[100]\i[au]are y\i[o]\![anim,clear,au]ou ce\i[a]\![anim,clear,o]rtain\i[ch]\![anim,clear,a] you'\i[a]\![anim,clear,ch]re not bored y\i[ch]\![anim,clear,a]et?\e"
