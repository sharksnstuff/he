				" takes "
				--
				"queen"
				"knight"
				"rook"
				"pawn"
				"bishop"
				--
				"... \w8zzz...\e"
			}
			{
				"\s[96]Zzz... \w8castle "
				--
				"kingside"
				"queenside"
				--
				"... \w8zzz..."
			}
			"\s[96]Zzz... \w8mm... \w8sandwich... \w8zzzz..."
			"\s[97]Zz... \w8Misha, stop... \w8stop it, don't... \w8zzz..."
			"\s[96]Zzz... \w8more gun... yes, \w6more... \w8zzzz..."
			"\s[96]Zzz... \w8well... \w8now we know... \w8zzz..."
			"\s[97]Zzzz... \w8excessive urine... \w8zzz... \w8Dummkopf... \w8zzzz..."
			"\s[97]Zzz... \w8hrrk... \w8no smoking... \w8how many times... \w8zzzz..."
			"\s[96]Zzzz... \w8groundbreaking... \w8zz... \w8total atlanto-occipital... \w8zzz..."
