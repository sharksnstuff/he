			"\s[96]Zzzz... \w8scalpel... \w8zz... \w8forceps... \w8zzz... \w8ketchup... \w8zzzzz...\e"
			if minsincewake >= 120
			{
				"\s[97]Zzhk... \w8n-no, \w4that's... \w8that shouldn't be... \w8everyone, I—\w2no, no, please, don't—\w3\![raise,OnWakingUp]\s[80]\i[0]STOP—!\n\n[half]\w8\w8\w8\w8\w8\s[122]\i[a]A-ah, \w4\i[ch]\![anim,clear,a]did \s[22]\i[au]I jus\i[ch]\![anim,clear,au]t...? \w4\s[23]\i[au]How long \i[ch]\![anim,clear,au]was \i[au]\![anim,clear,ch]I asle\i[a]\![anim,clear,au]ep for\i[ch]\![anim,clear,a]?\n\n[half]\w8\w8\w8\s[234]\i[base]\i[armcross]\f[italic,true](He scrambles to compose himself.)\n\n[half]\w4\f[italic,false].\w4.\w4.\w4\s[230]\i[a]my apologi\s[133]\i[ch]es.\e"
			}
