//---------------------------Miscellaneous Functions--------------------------

//This .dic file is concerned with a number of functions that didn't quite fit in anywhere else. If you're adding new functions, this may be the place to do it! This also has the functions related to updating your ghost, among others. Most of this will just be replacing simple placeholder dialogue with dialogue more appropriate for your ghost. 

//This is basically bonus features and flavor text for a few of the more uncommon functions of a ghost. You don't HAVE to fill these out if you don't want to, the template's default dialogue will handle it (assuming you're making a two person ghost... if not, you may have to go through and remove Triangle's dialogue tags so he doesn't appear when you don't want him to). So if this file is boring or intimidating or you don't care, you can ignore it! These are again edge-cases compared to how often you'll see aitalk, bootend, or menu dialogue instead.

/*
This file has...

OnInstallBegin
OnInstallComplete
OnInstallFailure
OnInstallRefuse
OnVanishSelecting
OnVanishSelected
OnVanishCancel
OnVanishButtonHold
OnVanished
OnBIFFBegin
OnBIFFComplete
OnBIFFFailure
OnUpdateBegin
OnUpdateReady
OnUpdateComplete
OnUpdateFailure
OnUpdate.OnDownloadBegin
OnUpdate.OnMD5CompareBegin
OnUpdate.OnMD5CompareComplete
OnUpdate.OnMD5CompareFailure
OnHeadlinesenseBegin
OnHeadlinesense.OnFind
Select.Headline_Cancel
OnHeadlinesenseComplete
OnHeadlinesenseFailure
OnUpdatedataCreating
OnUpdatedataCreated
OnNarCreating
OnNarCreated
OnSNTPBegin
OnSNTPCompare
OnSNTPEXECUTE
OnSNTPCANCEL
OnSNTPFailure
OnDisplayChange
OnScreenSaverStart
OnScreenSaverEnd
OnApplicationBoot
OnApplicationClose
OnApplicationFileOpen
OnBatteryLow
OnBatteryCritical
OnShellScaling
OnFileDrop2
*/

//You can guess at what each function does by its name for the most part. You can go through and find the functions that seem the most interesting, or the most likely, to appear and then just fill those out if you don't want to do all of them. Or, if you want to go full nuclear, you can just wipe this whole file and let SSP's default dialogue handle whenever these scenarios come up. It depends on what you have the energy for and how thorough you want to be.

//This file IS long, but you'll only have to do it once! Probably. And again, you don't have to do all of it, or even most of it if you don't want to. Don't let this be a roadblock for you! It's basically bonus material! What matters is your aitalk file more than anything. You can always come back to this and fill it out over time once your ghost is already published. Don't get stuck here! I know it's easy to do so but don't let it happen to you! If you're getting stuck here just walk out, you can leave! lol. There's always aitalk, bootend, and menu to have more fun with, and that's the dialogue your user is going to see the most often.


//Make sure to read the walkthrough page (http://www.ashido.com/ukagaka/walkthrough.html) for more details about how to properly format ghost dialogue!

//I will reiterate that you should be editing these in Notepad++, and in particular, you should set the Language to C (or Java I guess) to properly highlight all the text. It will make things A LOT EASIER for you, trust me! It will also help you keep track of your brackets in case you forget some. If you click on a line with a bracket in Notepad++, it should highlight where the other bracket ends, or turn purple if there's no finishing bracket (which you should definitely fix!)
//It will also highlight my commented lines in green, so you'll know where they are. Any line beginning with // is a commented line that the code will not read. It's just for your reference!


//If you see a big block of commented text you want to uncomment, highlight the text and then hit ctrl-shift-k in Notepad++ and that should uncomment it. Mostly this is intended for advanced users.



 //---- OnInstallBegin -------------------------------------------------------
 //OnInstallBegin is called when a file with an included install.txt is dropped on your ghost. This primarily means things like .nar files for other ghosts or .zip files containing balloons or shells for your ghosts. Primarily ghost-related things. Replace as you want.
 
OnInstallBegin
{
	if sleeping == 1
	{
		sleeping = 0
		sitting = 0
		
		sleeptimer = 0
		waketimer = 1
		minsincewake = 0
		"\s[80]\i[0]GhhHUH—!\n\n[half]\w4\s[24]\i[a]What\i[ch]\![anim,clear,a]—\w4\s[23]\i[a]where—\n\n[half]\w4\s[0]\i[ch]D-di\i[a]\![anim,clear,ch]d you\i[o]\![anim,clear,ch] nee\i[a]\![anim,clear,o]d somet\i[ch]\![anim,clear,a]hing???\n\n[half]\w8\w8\w4\c"
	}
	--
	"\0\s[132]\i[base]\i[armcross]I'm g\i[a]\![anim,clear,base]uess\i[ch]\![anim,clear,a]ing \i[a]\![anim,clear,ch]I have n\i[o]\![anim,clear,a]o cho\i[au]\![anim,clear,o]ice.\i[ch]\![anim,clear,au].. \w5\s[232]\i[a]very wel\i[ch]\![anim,clear,a]l.\s[70]\i[ch]Er, \w3\i[a]\![anim,clear,ch]let's\i[ch]\![anim,clear,a] see...\e"
}

 //---- OnInstallComplete -------------------------------------------------------
 //OnInstallComplete runs once the file above has finished installing.
 
OnInstallComplete
 {
	"\0" //this means your main character will be speaking first, therefore the \s[] at the beginning of each line will be defining your main character's pose.
 	--
	if reference0 == "shell" //This is checking to see if what you installed is classified as a shell in the install.txt. Remember the line in install.txt that said type,ghost or type,shell? This is why that line is important, that's what tells the program what it's installing like so.
 	{	
		if reference1 == "Hypothetical Shell that doesn't actually exist" //This is the name of your shell as you defined in descript.txt in the shell folder.
		{
		"\s[0]Installed Hypothetical Shell. Truncated for space.\e"
		}
		else //For any other shell they may install.
		{
		"\s[70]\i[o]How i\i[ch]\![anim,clear,o]ntere\i[a]\![anim,clear,ch]sting\i[ch]\![anim,clear,a]. \w5\s[71]\i[ch]It s\i[a]\![anim,clear,ch]ays he\i[ch]\![anim,clear,a]re it\i[a]\![anim,clear,ch]'s a\i[ch]\![anim,clear,a] shel\i[a]\![anim,clear,ch]l cal\i[ch]\![anim,clear,a]led \i[a]\![anim,clear,ch]%(reference1)..\i[ch]\![anim,clear,a].   \w5\s[232]\i[ch]\i[armcross] it's\i[a]\![anim,clear,ch] been\i[ch]\![anim,clear,a] ins\i[au]\![anim,clear,ch]talled\i[ch]\![anim,clear,au].\e"
		//%(reference1) here would be the name of the shell they installed. Replace if needed.
		}
 	}
	elseif reference0 == "ghost" //if the type of the file they're installing is a ghost.
 	{
		"\s[170]\i[a]Ah. \i[base]\![anim,clear,a]\w5\s[171]\i[au]Found a\i[o]\![anim,clear,au] new\i[a]\![anim,clear,o] victi\i[base]\![anim,clear,a]m to \i[o]\![anim,clear,base]hold\i[au]\![anim,clear,o] captive\i[ch]\![anim,clear,au] for\i[a]\![anim,clear,ch] your a\i[ch]\![anim,clear,a]muse\i[o]\![anim,clear,ch]ment,\i[ch]\![anim,clear,o] I \i[a]\![anim,clear,ch]see? \i[ch]\![anim,clear,a]\w5\s[170]\i[a]Well, i\i[ch]\![anim,clear,a]f I \i[a]\![anim,clear,ch]must..\i[ch]\![anim,clear,a].\n\n[half]\f[italic,true]\w5(%(reference1) has been installed.)\e"
 	}
	elseif reference0 == "balloon" //if the type of file is a balloon
 	{
		"\s[71]\i[ch]What\i[au]\![anim,clear,ch] on e\i[ch]\![anim,clear,au]arth \i[o]\![anim,clear,ch]do you \i[ch]\![anim,clear,o]need \i[a]\![anim,clear,ch]a '%(reference1)'\i[base]\![anim,clear,a] bal\i[a]\![anim,clear,base]loon\i[o]\![anim,clear,a] for?\i[ch]\![anim,clear,o] \w6\s[232]\i[armcross]\i[ch]It's \i[a]\![anim,clear,ch]been\i[ch]\![anim,clear,a] inst\i[au]\![anim,clear,ch]alled\i[ch]\![anim,clear,au].\e"
		//Reference1 here would be the name of the balloon. Replace as needed.
 	}
	elseif reference0 == "plugin" //if the type of file is a plug-in
 	{
		"\s[70]\i[a]%(reference1).\i[ch]\![anim,clear,a].. \w5\s[71]\i[a]this \i[au]\![anim,clear,a]plug\i[ch]\![anim,clear,au]-in w\i[o]\![anim,clear,ch]ould\i[ch]\![anim,clear,o]n't \i[a]\![anim,clear,ch]happ\i[ch]\![anim,clear,a]en t\i[o]\![anim,clear,ch]o pos\i[ch]\![anim,clear,o]e any\i[a]\![anim,clear,ch] harm \i[base]\![anim,clear,a]to an e\i[o]\![anim,clear,base]ntit\i[ch]\![anim,clear,o]y liv\i[a]\![anim,clear,ch]ing insi\i[ch]\![anim,clear,a]de th\i[a]\![anim,clear,ch]e progra\i[ch]\![anim,clear,a]m, w\i[o]\![anim,clear,ch]ould \i[base]\![anim,clear,o]it? \i[a]\![anim,clear,base]\w4\i[ch]\![anim,clear,a]\w8\w3\s[170]\i[a]Just asking\i[ch]\![anim,clear,a].\n\n[half]\f[italic,true]\w5(It's been installed.)\e"
		//Reference1 here would be the name of the plug-in. Replace as needed.
 	}
	elseif reference0 == "calendar skin" //if the type of file is a calendar skin
	{
		"\s[70]\i[a]A calend\i[ch]\![anim,clear,a]ar s\i[a]\![anim,clear,ch]kin?\i[ch]\![anim,clear,a] \w5\s[71]\i[o]Do you\i[a]\![anim,clear,o] real\i[ch]\![anim,clear,a]ly sp\i[a]\![anim,clear,ch]end that m\i[ch]\![anim,clear,a]uch t\i[a]\![anim,clear,ch]ime l\i[o]\![anim,clear,a]ooki\i[ch]\![anim,clear,o]ng a\i[a]\![anim,clear,ch]t yo\i[o]\![anim,clear,a]ur ca\i[a]\![anim,clear,o]lendar?\i[ch]\![anim,clear,a] \w5\s[133]\i[a]\i[armcross]It's\i[ch]\![anim,clear,a] inst\i[au]\![anim,clear,ch]alled\i[o]\![anim,clear,au] now,\i[ch]\![anim,clear,o] in a\i[a]\![anim,clear,ch]ny case\i[ch]\![anim,clear,a].\e"
	}
	elseif reference0 == "headline" //if the file/url you drop on them is counted as a headline. To be honest with you I don't know what determines whether a url is a headline or what.
	{
		"\0\s[71]\i[au]Are \i[o]\![anim,clear,au]you e\i[a]\![anim,clear,o]ven \i[ch]\![anim,clear,a]aware\i[a]\![anim,clear,ch] of w\i[o]\![anim,clear,a]hat \i[a]\![anim,clear,o]this \i[ch]\![anim,clear,a]is f\i[o]\![anim,clear,ch]or? \i[ch]\![anim,clear,o]\w5\s[70]\i[a]I ho\i[base]\![anim,clear,a]pe yo\i[o]\![anim,clear,base]u kno\i[a]\![anim,clear,o]w wha\i[ch]\![anim,clear,a]t yo\i[o]\![anim,clear,ch]u're do\i[ch]\![anim,clear,o]ing \i[a]\![anim,clear,ch]here,\i[ch]\![anim,clear,a] for \i[o]\![anim,clear,ch]both\i[au]\![anim,clear,o] our \i[a]\![anim,clear,au]sakes\i[ch]\![anim,clear,a].\n\n[half]\f[italic,true]\w5(%(reference1) has been installed.)\e"
	}
	elseif reference0 == "rss" //this is more clearly for when you drag an rss feed onto your ghost. you can find rss feeds on sites by looking for the little rss icon, it kind of looks like a little satellite. you can google more info on rss feeds if you're curious! They're neat!
	{
		"\0\s[170]\i[au]RSS...\i[ch]\![anim,clear,au] \w5\s[70]\i[a]What \i[ch]\![anim,clear,a]the \i[a]\![anim,clear,ch]devil\i[ch]\![anim,clear,a] is \i[a]\![anim,clear,ch]an RSS? \i[ch]\![anim,clear,a]\w5\s[71]\i[au]What\i[a]\![anim,clear,au] exac\i[ch]\![anim,clear,a]tly a\i[a]\![anim,clear,ch]re y\i[o]\![anim,clear,a]ou ha\i[a]\![anim,clear,o]ving \i[ch]\![anim,clear,a]me pu\i[o]\![anim,clear,ch]t on\i[au]\![anim,clear,o] thi\i[ch]\![anim,clear,au]s com\i[a]\![anim,clear,ch]puter\i[ch]\![anim,clear,a] for\i[o]\![anim,clear,ch] you?\i[ch]\![anim,clear,o]\n\n[half]\f[italic,true]\w5(%(reference1) has been installed.)\e"
	}
	else //for any other file they'd install
	{
		"\s[232]\i[au]\i[armcross]Done\i[ch]\![anim,clear,au].\n\n[half]\f[italic,true]\w5(%(reference1) has been installed.)\e"
	}
}

//---- OnInstallFailure -------------------------------------------------------
//If the file you dropped fails to install for one reason or another.

OnInstallFailure
 {
	"\0\s[70]\i[o]Ooh, i\i[ch]\![anim,clear,o]t's—\n\n[half]\w5\s[170]\i[a]Ah. \i[base]\![anim,clear,a]\w6" //this first bit of dialogue begins the explanation of what happened. You can replace this with an appropriate intro statement.
	--
	if reference0 == "unsupported" //These if statements determine how it happened to finish the piece of dialogue. This checks if the reason it failed is because it was unsupported.
	{
	"\s[171]\i[ch]Seems\i[a]\![anim,clear,ch] like\i[ch]\![anim,clear,a] the\i[au]\![anim,clear,ch] file\i[ch]\![anim,clear,au] is u\i[a]\![anim,clear,ch]nsupp\i[o]\![anim,clear,a]orted\i[ch]\![anim,clear,o].\e"
	//Replace with whatever dialogue for an unsupported file you may come up with.
	}	
	elseif reference0 == "extraction" //This checks if the file didn't extract properly.
	{
	"\i[au]\![anim,clear,base]I cou\i[o]\![anim,clear,au]ldn'\i[ch]\![anim,clear,o]t ext\i[a]\![anim,clear,ch]ract\i[ch]\![anim,clear,a] it \i[au]\![anim,clear,ch]proper\i[ch]\![anim,clear,au]ly. \w6\s[40]\i[o]Perh\i[a]\![anim,clear,o]aps t\i[ch]\![anim,clear,a]he f\i[a]\![anim,clear,ch]ile i\i[ch]\![anim,clear,a]s da\i[a]\![anim,clear,ch]maged\i[ch]\![anim,clear,a]?\e"
	//See above but for a failed extraction.
	}
 }
 
 //--OnInstallRefuse
 //If the file you dropped can't be installed with this ghost.
 
OnInstallRefuse
 {
	"\0\s[70]\i[o]Ooh, i\i[ch]\![anim,clear,o]t's—\n\n[half]\w5\s[170]\i[a]Ah. \i[base]\![anim,clear,a]\w5\i[ch]\![anim,clear,base]It's \i[au]\![anim,clear,ch]not f\i[o]\![anim,clear,au]or m\i[ch]\![anim,clear,o]e.\n\n[half]\w8\w1\s[131]\i[base]\i[armcross]Appar\i[a]\![anim,clear,base]ently\i[ch]\![anim,clear,a] only\i[a]\![anim,clear,ch] %(reference0)\i[ch]\![anim,clear,a] can\i[a]\![anim,clear,ch] inst\i[ch]\![anim,clear,a]all \i[au]\![anim,clear,ch]this \i[ch]\![anim,clear,au]parti\i[a]\![anim,clear,ch]cular fil\i[ch]\![anim,clear,a]e. \w5\s[201]\i[a]\i[armup]A sham\![anim,clear,a]e.\e"
	
	//reference0 in this function refers to the ghost this file is associated with, probably the name of the ghost listed in its install.txt file. You would see this if you dropped a shell made for a different ghost on your current ghost, for example. They can't install a shell for themselves they can't use, right? Anyway, replace this with what you wish, you can use the reference0 envelope or not if you want.
 }


//**** Uninstallation ******************************************
//You may have noticed in the configuration menus in menu.dic an option to turn Uninstall on or off, as well as a greyed out option to uninstall in the right click menu. These following functions relate to the uninstallation process when it's on. Replace the dialogue in each function as we go along.


//--OnVanishSelecting
//When you select the uninstall option in the menu.

OnVanishSelecting
{
	"\0\f[italic,true](Do you really want to uninstall him...?)\e"
}

//OnVanishSelected
//When you decide to uninstall them. 

OnVanishSelected
{
	if sleeping == 1
	{
		"\0Zzz... \w8mmfg... \w8nn...? \w8Zzz...\e"
	}
	else
	{
		"\0\s[1]\i[au]Ah, y\i[o]\![anim,clear,au]ou ac\i[a]\![anim,clear,o]tual\i[ch]\![anim,clear,a]ly CA\i[hapia]\![anim,clear,ch]N get bo\i[o]\![anim,clear,hapia]red! \i[hapich]\![anim,clear,o]\w5\s[240]\i[hapia]\i[armcross]I wa\i[hapich]\![anim,clear,hapia]s re\i[hapia]\![anim,clear,hapich]ally starti\i[hapich]\![anim,clear,hapia]ng to\i[o]\![anim,clear,hapich] get\i[hapich]\![anim,clear,o] wor\i[hapia]\![anim,clear,hapich]ried, ha!\i[hapich]\![anim,clear,hapia]\w9\w9\e"
	}
}


//--OnVanishCancel
//If you select Uninstall from the menu, but decide not to do it.

OnVanishCancel
{
	if sleeping == 1
	{
		"\0Zzz... zzznn... zzz...\e"
	}
	else
	{
	"\0\s[101]\i[a]Ah... \w4\s[151]\i[a]\i[arm1up]\i[arm2up]and h\i[ch]\![anim,clear,a]ere I\i[au]\![anim,clear,ch] was \i[o]\![anim,clear,au]think\i[ch]\![anim,clear,o]ing y\i[o]\![anim,clear,ch]ou'd\i[a]\![anim,clear,o] final\i[ch]\![anim,clear,a]ly go\i[a]\![anim,clear,ch]tten bore\i[ch]\![anim,clear,a]d of \i[au]\![anim,clear,ch]all \i[a]\![anim,clear,au]this.\i[ch]\![anim,clear,a] \w5\s[251]\i[o]Oh w\i[a]\![anim,clear,o]ell.\i[ch]\![anim,clear,a]\e"
	}
}

//--OnVanishButtonHold
//This should trigger if you double click the ghost's balloon in the middle of OnVanishSelected above. So it basically cancels their uninstallation. I'd be pretty careful about testing this, and I'd probably just put the line of dialogue into their script input and test it that way instead.

OnVanishButtonHold
{
	if sleeping == 1
	{
		"\0Zzzz...\e"
	}
	else
	{
	"\0\s[100]\i[a]The fickle\i[ch]\![anim,clear,a] sort\i[au]\![anim,clear,ch], are\i[o]\![anim,clear,au]n't \i[ch]\![anim,clear,o]you?\e"
	}
}


 //---- OnVanished -----------------------------------------
 //OnVanished is a weird little function. Basically, if you uninstall a ghost, it'll automatically go back to the last ghost you were using. They'll then say this line of dialogue about the ghost you just uninstalled. This is very annoying to test as you can imagine! But unlikely to come up super often, I bet. Make sure to set up both their poses immediately so they both appear when it switches back to them.
 
OnVanished
 {
	"\0\s[60]\i[o]So d\i[a]\![anim,clear,o]id th\i[ch]\![anim,clear,a]at ki\i[a]\![anim,clear,ch]ll %(reference0)\i[ch]\![anim,clear,a], or\i[o]\![anim,clear,ch] mer\i[a]\![anim,clear,o]ely f\i[ch]\![anim,clear,a]ree t\i[a]\![anim,clear,ch]hem p\i[ch]\![anim,clear,a]erman\i[a]\![anim,clear,ch]ently from t\i[ch]\![anim,clear,a]his \i[au]\![anim,clear,ch]prog\i[ch]\![anim,clear,au]ram's\i[a]\![anim,clear,ch] confines?\i[ch]\![anim,clear,a] \w5\s[33]\i[ch]\i[armcross]The s\i[a]\![anim,clear,ch]cien\i[ch]\![anim,clear,a]ce of\i[o]\![anim,clear,ch] thi\i[ch]\![anim,clear,o]s al\i[au]\![anim,clear,ch]l is \i[a]\![anim,clear,au]so fascinating\i[ch]\![anim,clear,a]...\e"
}


//**** Mail Checking *******************************************************************
//The next set of functions have to do with checking your email. This function is a slippery little thing - I've had people test it following my directions and have it work, but I've never actually gotten it to report back the right amount of emails myself. Very frustrating. But perhaps you'll have more luck with it, haha.
//Girl and Triangle can't actually read your email, they can just tell you how many emails you have. I've seen ghosts that can read the HEADERS of email, but I still don't think ghosts can actually display the contents of an email. You should be using your actual email client for that. It's still kind of a neat feature though.


//*********************Advanced User Info*******************************
//These text boxes are meant for those who have an interest in expanding or using more complicated functions in their ghost. Also for my own reference in the future since I plan on using this template too, haha. If you have no interest in any of this and just want to keep things as simple as possible, feel free to skip these boxes.

//If you want to set up your ghost to check your mail so you can more easily check these messages instead of just writing the dialogue and moving on, it's a little bit tricky, but not super hard.
//Basically, you're going to need to find your POP settings for your email account. Googling your provider + POP should bring it up pretty quick. Once you have the info, you'll go to the right click menu, options, then preferences. A big menu should pop up, and you should see POP in the left side. Click that, and input all the info from the POP page you looked up for your account. Tell your ghost to check your email, and if it works, then congratulations!
//***********************************************************************


 //---- OnBIFFBegin ---------------------------------------------------------------
 //When you first tell the ghost to check your email. An intro statement, if you will. Replace with whatever you like.
 
OnBIFFBegin
 {
	if mailonce 
	{
			mailonce = 1
			"\s[62]\i[o]Ooh! \w4\i[hapia]\![anim,clear,o]Lett\i[hapich]\![anim,clear,hapia]ing m\i[o]\![anim,clear,hapich]e poke\i[hapich]\![anim,clear,o] thr\i[o]\![anim,clear,hapich]ough\i[hapia]\![anim,clear,o] your \i[hapich]\![anim,clear,hapia]perso\i[hapia]\![anim,clear,hapich]nal i\i[hapich]\![anim,clear,hapia]nfor\i[hapia]\![anim,clear,hapich]mati\i[hapich]\![anim,clear,hapia]on, \w1\i[hapia]\![anim,clear,hapich]are \i[o]\![anim,clear,hapia]you?\i[hapich]\![anim,clear,o]\n\n[half]\w6\s[170]\i[au]How \i[a]\![anim,clear,au]gener\i[o]\![anim,clear,a]ous.\i[ch]\![anim,clear,o]\e"
	}
	else
	{
		"\0\s[62]\i[ch]You k\i[o]\![anim,clear,ch]now, \w2\i[base]\![anim,clear,o]mos\i[o]\![anim,clear,base]t peo\i[a]\![anim,clear,o]ple wou\i[o]\![anim,clear,a]ldn't\i[ch]\![anim,clear,o] be s\i[o]\![anim,clear,ch]o eag\i[ch]\![anim,clear,o]er to l\i[o]\![anim,clear,ch]et a\i[a]\![anim,clear,o] man \i[base]\![anim,clear,a]like \i[a]\![anim,clear,base]me go thr\i[ch]\![anim,clear,a]ough \i[o]\![anim,clear,ch]their\i[ch]\![anim,clear,o] pers\i[a]\![anim,clear,ch]onal \i[ch]\![anim,clear,a]affect\i[a]\![anim,clear,ch]s like thi\i[ch]\![anim,clear,a]s. \w5\s[71]\i[a]I sup\i[o]\![anim,clear,a]pose \i[ch]\![anim,clear,o]you'r\i[au]\![anim,clear,ch]e not\i[o]\![anim,clear,au] most\i[a]\![anim,clear,o] peopl\i[o]\![anim,clear,a]e though\i[base]\![anim,clear,o], hmm?\e"
		
		functiontalk
	}
 }

 
 //---- OnBIFFComplete ---------------------------------------------------------------
 //After they've succeeded in checking your mail, they'll report back with how many new emails you have. Replace the dialogue with whatever would be character appropriate.
 
OnBIFFComplete
 {
	if reference0 == 0 
 	{
