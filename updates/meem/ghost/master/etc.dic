 	}
	--
 	"\e" //And here is the final /e, so you don't need to include it in the if statements above. Another one of the very rare cases this occurs.
}


//**** Ghost Creation and Updating ******************************************************
//These next few are related to creating updates2.dau and .nar files for your ghosts. You'll want to at least make a .nar to distribute your ghost, and if you're going to be using Network Update, you'll also want to make updates2.dau as well. It's unlikely that anyone other than you will see these messages, but they can be fun to add some color to while you're developing. I gave Temmie some silly ones and they make me smile each time I update her.
//Primarily, you will see these messages when you're creating your updates file or updating your ghost.nar file. More on this on the walkthrough page. However, you can drag and drop another ghost's folder onto them and they'll also create a nar for that as well, if for some reason you want to do that.


 //---- OnUpdatedataCreating -----------------------------------------------------------
 //This will begin the creation of the updates2.dau file. Not unlike the other beginning functions you've seen throughout this file. Replace with whatever you like.
 
OnUpdatedataCreating
 {
	"\0\f[italic,true](Creating update file...)\e"
 }

 //---- OnUpdatedataCreated -------------------------------------------------------------
 //After the updates2.dau file has been successfully created. Replace with whatever.
 
OnUpdatedataCreated
 {
	"\0\f[italic,true](File created.)\e"
 }

 //---- OnNarCreating ------------------------------------------------------------------
 //Along the same lines, this is when they begin creating a .nar file for your ghost. .nars are the format most ghosts will be in, something similar to a .zip file, and this is the format you'll be distributing your ghost in most likely. Replace the dialogue with whatever you like.
 
OnNarCreating
 {
	"\0\f[italic,true](Creating .nar file...)\e"
 }

 //---- OnNarCreated -------------------------------------------------------------------
 //After the nar file has been successfully created.
 
OnNarCreated
 {
	"\0\f[italic,true](The .nar has been created.)\e"
	//reference0 here will be the filename of the nar you just created. It should drop the nar in the folder where all your ghosts are listed, ssp\ghost\.
 }

 //****　Clock Synchronization　**********************************************************
//**** 미카 (http://homepage2.nifty.com/ko-ki/)의 사전을 참고했습니다．감사＞こ 나무 성
//This set of functions was done by the above Korean coder, I think. I'll leave their comment there untouched. 
//If you right click your ghost and go into the Utilities menu, there's an option called NTP Time Sync. That's what this is for!
 

 //----OnSNTPBegin ------------------------------------------------------------------
 //As with the others you've seen above, this is the beginning bit of dialogue for this process.
 
OnSNTPBegin
 {
	if sleeping == 1
	{
		sleeping = 0
		sitting = 0
		
		sleeptimer = 0
		waketimer = 1
		minsincewake = 0
		"\s[80]\i[0]GhhHUH—!\n\n[half]\w4\s[24]\i[a]What\i[ch]\![anim,clear,a]—\w4\s[23]\i[a]where—\n\n[half]\w4\s[0]\i[ch]D-di\i[a]\![anim,clear,ch]d you\i[o]\![anim,clear,ch] nee\i[a]\![anim,clear,o]d somet\i[ch]\![anim,clear,a]hing???\n\n[half]\w8\w6"
	}
	--
	"\0\s[62]\i[ch]Check\i[o]\![anim,clear,ch] you\i[au]\![anim,clear,o]r clo\i[ch]\![anim,clear,au]ck? \w8"
	--
	if workformeboy == 1
	{
		"\s[162]\i[au]Are \i[o]\![anim,clear,au]you r\i[a]\![anim,clear,o]unnin\i[ch]\![anim,clear,a]g ou\i[au]\![anim,clear,ch]t of \i[ch]\![anim,clear,au]idea\i[a]\![anim,clear,ch]s for me\i[ch]\![anim,clear,a]nial \i[o]\![anim,clear,ch]task\i[a]\![anim,clear,o]s to \i[ch]\![anim,clear,a]force\i[a]\![anim,clear,ch] me \i[o]\![anim,clear,a]into?\i[ch]\![anim,clear,o] \w5\s[170]\i[a]Alrig\i[ch]\![anim,clear,a]ht, I\i[a]\![anim,clear,ch]'ll \i[o]\![anim,clear,a]use \i[a]\![anim,clear,o]%(reference0).\i[ch]\![anim,clear,a]\e"
	}
	else
	{
		"\s[133]\i[a]\i[armcross]I sup\i[base]\![anim,clear,a]pose\i[o]\![anim,clear,base] I c\i[a]\![anim,clear,o]an d\i[ch]\![anim,clear,a]o t\i[o]\![anim,clear,ch]hat.\i[ch]\![anim,clear,o].. \w5\s[170]\i[a]I'll\i[ch]\![anim,clear,a] just\i[o]\![anim,clear,ch] use \i[a]\![anim,clear,o]%(reference0)\i[ch]\![anim,clear,a].\e"
	}
	//%(reference0) here is the site they'll be using to check your clock. I wouldn't worry too much about what the site is or where it's defined, it should be accurate. Replace the dialogue with what you need, you don't have to use reference0 if you don't want to.
 }


 //----　OnSNTPCompare----------------------------------------------------------
 //Now the ghost is going to compare the current time of your computer's system to the time of the site they connected to. Most of this you don't have to touch, just replace the dialogue as indicated.
 
OnSNTPCompare
{
 	"\f[italic,true]Retrieved Time: %reference1[1]/%reference1[2]/%reference1[0] %reference1[3]:%reference1[4]:%reference1[5]\w2\n/
	Your Time: %reference2[1]/%reference2[2]/%reference2[0] %reference2[3]:%reference2[4]:%reference2[5]\w2\n/
 	\n\f[italic,false]"
	--
 	if reference3 == 0 //if your clock is already accurate.
	{
 		"\0\s[201]\i[o]Your \i[au]\![anim,clear,o]cloc\i[ch]\![anim,clear,au]k is \i[a]\![anim,clear,ch]fine.\i[ch]\![anim,clear,a]\e" //replace this with whatever message you like.
	}
 	else //if your clock doesn't match
	{
 		"\0\s[62]\i[o]Oh, y\i[ch]\![anim,clear,o]our \i[o]\![anim,clear,ch]cloc\i[au]\![anim,clear,o]k is\i[ch]\![anim,clear,au] out\i[a]\![anim,clear,ch] of sy\i[ch]\![anim,clear,a]nc. \w5\s[161]\i[base]I'm g\i[a]\![anim,clear,base]uess\i[ch]\![anim,clear,a]ing y\i[o]\![anim,clear,ch]ou c\i[a]\![anim,clear,o]an't \i[ch]\![anim,clear,a]be bo\i[au]\![anim,clear,ch]there\i[ch]\![anim,clear,au]d to\i[o]\![anim,clear,ch] fix\i[a]\![anim,clear,o] it \i[ch]\![anim,clear,a]your\i[a]\![anim,clear,ch]self..\i[ch]\![anim,clear,a].\n\n[half]/
		![*]\q[Fix it,OnSNTPEXECUTE]\n/
 		\![*]\q[Leave it alone,OnSNTPCANCEL]\e"
	}
}

 //----　OnSNTPEXECUTE ------------------------------------------------------------------
 //After they've fixed your clock. Note the \6 tag - that's what actually changes the clock. Do not remove that tag. Replace the rest with what you want.
 
OnSNTPEXECUTE
 {
	"\0\s[132]\i[a]\i[armcross]Very wel\i[ch]\![anim,clear,a]l. \w5\s[260]\i[ch]One m\i[o]\![anim,clear,ch]oment\i[ch]\![anim,clear,o]... \n\n[half]\w8\w8\w6\6\s[132]\i[a]\i[armcross]Done.\i[ch]\![anim,clear,a] \w5\s[200]\i[o]You'\i[a]\![anim,clear,o]re welc\i[base]\![anim,clear,a]ome.\e"
 }

 //----　OnSNTPCANCEL ------------------------------------------------------------------
 //If you decide not to change your clock when they tell you it doesn't match. Replace with what you want.
 
OnSNTPCANCEL
 {
	"\0\s[131]\i[ch]\i[armcross]\f[italic,true](He gives a scoff of annoyance.)\e"
 }

 //----　OnSNTPFailure ------------------------------------------------------------------
 //If they can't change the clock for some reason, possibly because the site timed out but it could be anything. Replace with what you want.
 
OnSNTPFailure
 {
	"\0\s[70]\i[base]Hm. \w5\s[71]\i[au]Some\i[ch]\![anim,clear,au] kin\i[o]\![anim,clear,ch]d of\i[a]\![anim,clear,o] error \i[ch]\![anim,clear,a]is ke\i[a]\![anim,clear,ch]eping m\i[ch]\![anim,clear,a]e fro\i[o]\![anim,clear,ch]m fi\i[a]\![anim,clear,o]xing i\i[ch]\![anim,clear,a]t. \w5\s[232]\i[a]\i[armcross]I'll \i[au]\![anim,clear,a]not b\i[ch]\![anim,clear,au]e bl\i[a]\![anim,clear,ch]amed.\i[ch]\![anim,clear,a]\e"
 }


 //--OnDisplayChange----------------------------------------------------------------
 //This is when you change the resolution of your monitor while your ghost is running. Don't mess with any of this, it should be fine as is.
 
OnDisplayChange
{
	displaybpp    = reference0
 	displaywidth  = reference1
	displayheight = reference2
}



 //---- OnScreenSaverStart -------------------------------------------------------
 //This happens if your ghost is running when your screensaver starts up. I've never got this to trigger but I love this idea, and I feel like there's a way to do it I haven't figured out yet. So you can skip these for now if you want, but if I do ever get it working, I'll come back and make a note of it.
 
OnScreenSaverStart
{
	if sleeping == 1
	{
		if sitting == 0
		{
			"\s[96]"
		}
		--
		"Zzz...\e"
	}
	else
	{
		"\0\s[60]\i[o]!!!!!\e"
	}
}

 //---- OnScreenSaverEnd -------------------------------------------------------
 //When you wiggle your mouse and stop your screensaver.
 
OnScreenSaverEnd
{
	if sleeping == 1
	{
		if sitting == 0
		{
			"\s[96]"
		}
		"Zz... \w8hmmn... \w8zzz...\e"
	}
	else
	{
	"\0\s[32]\i[o]\i[armcross]How \i[a]\![anim,clear,o]fasci\i[ch]\![anim,clear,a]nati\i[a]\![anim,clear,ch]ng..\i[ch]\![anim,clear,a]. \w5\s[133]\i[ch]I nev\i[a]\![anim,clear,ch]er c\i[o]\![anim,clear,a]onsid\i[au]\![anim,clear,o]ered \i[ch]\![anim,clear,au]what\i[a]\![anim,clear,ch] a screensa\i[ch]\![anim,clear,a]ver c\i[a]\![anim,clear,ch]ould \i[ch]\![anim,clear,a]look \i[o]\![anim,clear,ch]like\i[au]\![anim,clear,o] from\i[ch]\![anim,clear,au] the \i[o]\![anim,clear,ch]pers\i[ch]\![anim,clear,o]pecti\i[a]\![anim,clear,ch]ve of the scr\i[ch]\![anim,clear,a]een.\e"
	}
}


 //---- OnApplicationBoot ---------------------------------------------------------------
 //This supposedly is for when a program starts but I have honestly never gotten it to work or seen it happen. I wouldn't sweat these three related functions too much.
 
OnApplicationBoot
 {
	"\0\f[italic,true](%(reference0) just started.)\e"
 }

 //---- OnApplicationClose --------------------------------------------------------------
 //See above, but for the program closing.
 
OnApplicationClose
 {
	"\0\f[italic,true](%(reference0) has closed.)\e"
 }

 //---- OnApplicationFileOpen ----------------------------------------------------------
 //I believe this is for when the program detailed above opens a document file of some kind.
 
OnApplicationFileOpen
 {
	"\0\f[italic,true](Opening %(reference1).)\e"
 }




 
OnBatteryLow
 {
	if sleeping == 1
	{
		"\0\f[italic,true](Your battery is low... \w5you should probably plug it in soon.)\e"
	}
	else
	{
		"\0\s[61]\i[o]\i[armside]Your\i[a]\![anim,clear,o] lapt\i[au]\![anim,clear,a]op's\i[a]\![anim,clear,au] batt\i[ch]\![anim,clear,a]ery \i[o]\![anim,clear,ch]is lo\i[ch]\![anim,clear,o]w. \w5\s[161]\i[a]\i[armside]I wou\i[o]\![anim,clear,a]ldn'\i[ch]\![anim,clear,o]t no\i[o]\![anim,clear,ch]rmall\i[ch]\![anim,clear,o]y car\i[a]\![anim,clear,ch]e, bu\i[ch]\![anim,clear,a]t see\s[62]\i[a]ing as I'\i[base]\![anim,clear,a]m cur\i[au]\![anim,clear,base]rentl\i[ch]\![anim,clear,au]y tr\i[a]\![anim,clear,ch]apped \i[ch]\![anim,clear,a]insi\i[a]\![anim,clear,ch]de it\i[ch]\![anim,clear,a]...\e"
	}
 }
 
OnBatteryCritical
{
	if sleeping == 1
	{
		"\0\f[italic,true](Your laptop is about to die... \w5you should really do something about that soon, or you won't get to watch him sleep much longer.)\e"
	}
	else
	{
	"\0\s[101]\i[o]\i[armup]Your\i[a]\![anim,clear,o] lapt\i[au]\![anim,clear,a]op i\i[ch]\![anim,clear,au]s ab\i[a]\![anim,clear,ch]out \i[o]\![anim,clear,a]to die\i[ch]\![anim,clear,o].\w5\s[0]\i[o]Shou\i[a]\![anim,clear,o]ld I b\i[ch]\![anim,clear,a]e wo\i[a]\![anim,clear,ch]rried\i[ch]\![anim,clear,a] abo\i[a]\![anim,clear,ch]ut thi\i[o]\![anim,clear,a]s, or\i[ch]\![anim,clear,o]...?\e"
	}
}
 
//--OnBatteryNotify--------------------------------------------------------------------
//This I believe checks to see if your laptop is plugged in or not. Originally this bit of code was commented out, so I suspect it may not work. It may need a plug-in of some sort. Either way, you can delete it or fill it out as you like.
//Actually investigating this, leaving this in makes it so the ghost updates you about whether or not your computer is plugged-in constantly, which makes no sense for desktops. No doubt why it was commented out. You can delete it or just leave it be.

/*
OnBatteryNotify
{
	if reference2 == "online" //If your laptop is plugged in
	{
		"\0\s[0]The laptop is plugged in.\e"
	}
	elseif reference2 == "offline" //If you unplug your laptop
	{
		"\1\s[10]The laptop is not plugged in.\w8\0\s[0]Watch your battery.\e"
	}
}
*/


 //--OnShellScaling
 //This is a function however that you may actually use! Or at least, I often use it when desktop space is at a premium (which it always is on my computer). If you right click the ghost, you can go to Shell Scaling, which lists a number of different percentages. Those are the percentages your ghost can be scaled in size up or down. You can try them out yourself to get an idea of what I mean. I often scale mine down to get them out of the way sometimes. This adds dialogue whenever you change their scale. You don't have to do this if you don't want to, in which case they will just stay silent when you size them up or down. If that's what you want, just delete the whole thing or leave "" instead of any dialogue.
 
OnShellScaling
{
	if sleeping == 1
	{
		if sitting == 0
		{
			"\s[96]"
		}
		--
		"Zzz...\e"
		"Mmmrf... \w8zz...\e"
	}
	else
	{
		"\0\s[0]\i[a]What \i[ch]\![anim,clear,a]just \i[a]\![anim,clear,ch]happen\i[ch]\![anim,clear,a]ed?\e"
		"\0\s[1]\i[o]Ooh! \w5\i[a]\![anim,clear,o]Tingl\i[ch]\![anim,clear,a]y.\e"
	}
}


//--OnFileDrop2

//OnFileDrop2 handles how your ghost will set an image as the desktop background when someone drags and drops an image on them. You don't need to touch any of the coding here, just replace the dialogue as needed and leave the \q options alone. More about \q options in bootend.dic and in the walkthrough.

OnFileDrop2
{
	_filepath = SPLITPATH(reference0)
	_filename = _filepath[2]
	_fileext = TOLOWER(_filepath[3])
	
	if sleeping == 1
	{
		sleeping = 0
		sitting = 0
		
		sleeptimer = 0
		waketimer = 1
		minsincewake = 0
		"\s[80]\i[0]GhhHUH—!\n\n[half]\w4\s[24]\i[a]What\i[ch]\![anim,clear,a]—\w4\s[23]\i[a]where—\n\n[half]\w4\s[0]\i[ch]D-di\i[a]\![anim,clear,ch]d you\i[o]\![anim,clear,ch] nee\i[a]\![anim,clear,o]d somet\i[ch]\![anim,clear,a]hing???\n\n[half]\w8\w8\w4\c"
	}
	--
	case _fileext
	{
		when ".jpg", ".jpeg", ".bmp", ".png" //These are the formats your ghost will recognize as image files to set as the background.
		{
			Wallpaperfile = reference0
			
			"\0\s[70]\i[a]%(_filename)%(_fileext)\i[ch]\![anim,clear,a] is \i[a]\![anim,clear,ch]an im\i[ch]\![anim,clear,a]age. \w5\s[71]\i[a]What \i[o]\![anim,clear,a]do yo\i[au]\![anim,clear,o]u wa\i[ch]\![anim,clear,au]nt m\i[o]\![anim,clear,ch]e to do\i[ch]\![anim,clear,o] wit\i[a]\![anim,clear,ch]h this, exact\i[ch]\![anim,clear,a]ly?\n\n[half]\w5\f[italic,true](You tell him that you want it set as your wallpaper. \w5And that you want it...)\_q\n\n[half]/
			\![*]\q[Centered,SetWallpaper_0]\n/
			\![*]\q[Tiled,SetWallpaper_1]\n/
			\![*]\q[Stretched,SetWallpaper_2]\n\n[half]/
			\![*]\q[Actually never mind,SetWallpaper_Cancel]\e"
		}
		when ".mid", ".wav", ".mp3", ".wma", ".au" //Other file formats you might want to give your ghost a specific response to.
		{
			"\0\s[40]\i[a]%(_filename)%(_fileext)\i[ch]\![anim,clear,a] is \i[a]\![anim,clear,ch]an a\i[au]\![anim,clear,a]udio fi\i[ch]\![anim,clear,au]le. \w5\s[143]\i[a]\i[armcross]I don\i[o]\![anim,clear,a]'t b\i[ch]\![anim,clear,o]elie\i[a]\![anim,clear,ch]ve I can\i[ch]\![anim,clear,a] do \i[o]\![anim,clear,ch]anyt\i[a]\![anim,clear,o]hing wi\i[ch]\![anim,clear,a]th t\i[a]\![anim,clear,ch]his..\i[ch]\![anim,clear,a].\e"
		}
		others //Any other file format. As a note here, if you drop something ghost-related on them that does not have an install.txt, then they won't install it and will just say this response. If you are testing your balloon or nar files and you get this response instead of a proper installation, you should check and make sure you have an install.txt in the file!
		{
			"\s[100]\i[a]What\i[ch]\![anim,clear,a]? \w5\i[a]\![anim,clear,ch]\i[armup]What\i[ch]\![anim,clear,a] is \i[a]\![anim,clear,ch]this?\i[ch]\![anim,clear,a] \w5\s[130]\i[a]\i[armcross]I ca\i[ch]\![anim,clear,a]n't d\i[o]\![anim,clear,ch]o any\i[a]\![anim,clear,o]thing w\i[ch]\![anim,clear,a]ith t\i[a]\![anim,clear,ch]his.\i[ch]\![anim,clear,a]\e"
		}
	}
}

//This set of options sets the wallpaper up. You can replace the dialogue, but make sure to leave the \![set,wallpaper, etc.] tag at the beginning.

Select.SetWallpaper_0
{
	"\![set,wallpaper,%(Wallpaperfile),center]\0"
	--
	"\s[240]"
	"\s[161]\i[armside]"
	"\s[260]\i[armside]"
	"\s[232]\i[armcross]"
	"\s[133]\i[armcross]"
	"\s[101]\i[armup]"
	"\s[200]\i[armup]"
	"\s[201]\i[armup]"
	--
	"\i[a]Very wel\i[ch]\![anim,clear,a]l.\e"
}
Select.SetWallpaper_1
{
	"\![set,wallpaper,%(Wallpaperfile),center]\0"
	--
	"\s[240]"
	"\s[161]\i[armside]"
	"\s[260]\i[armside]"
	"\s[232]\i[armcross]"
	"\s[133]\i[armcross]"
	"\s[101]\i[armup]"
	"\s[200]\i[armup]"
	"\s[201]\i[armup]"
	--
	"\i[a]Very wel\i[ch]\![anim,clear,a]l.\e"
}
Select.SetWallpaper_2
{
	"\![set,wallpaper,%(Wallpaperfile),center]\0"
	--
	"\s[240]"
	"\s[161]\i[armside]"
	"\s[260]\i[armside]"
	"\s[232]\i[armcross]"
	"\s[133]\i[armcross]"
	"\s[101]\i[armup]"
	"\s[200]\i[armup]"
	"\s[201]\i[armup]"
	--
	"\i[a]Very wel\i[ch]\![anim,clear,a]l.\e"
}
Select.SetWallpaper_Cancel
{
	"\0\s[171]\i[base]\f[italic,true](You change your mind. \w5\s[230]\i[ch]\i[armcross]He tsks in annoyance.)\e"
}
