					"\0\s[230]\i[pout]\i[armcross]\f[italic,true](He grumbles something noncommittal under his breath.)\n\n[half]\w5\f[italic,false]\i[ch]\![anim,clear,pout]Fine. \w5\s[134]\i[ch]\i[armcross]I'm d\i[o]\![anim,clear,ch]oing\i[a]\![anim,clear,o] fine\i[ch]\![anim,clear,a].\n\n[half]\w5\f[italic,true](Doesn't sound like it.)\e"
					
					"\0\s[200]\i[a]Frank\i[ch]\![anim,clear,a]ly, I\i[base]\![anim,clear,ch]'m a \i[a]\![anim,clear,base]bit r\i[ch]\![anim,clear,a]eliev\i[a]\![anim,clear,ch]ed t\i[ch]\![anim,clear,a]o be\i[a]\![anim,clear,ch] here\i[ch]\![anim,clear,a]. \w5\s[120]\i[a]I hav\i[ch]\![anim,clear,a]e SO \i[o]\![anim,clear,ch]much \i[ch]\![anim,clear,o]paper\i[a]\![anim,clear,ch]work \i[ch]\![anim,clear,a]to be\i[a]\![anim,clear,ch] doi\i[ch]\![anim,clear,a]ng.\e"
					
					"\0\s[133]\i[a]Yest\i[au]\![anim,clear,a]erday\i[ch]\![anim,clear,au]'s ma\i[a]\![anim,clear,ch]tch wen\i[ch]\![anim,clear,a]t ra\i[a]\![anim,clear,ch]ther poorly.\i[ch]\![anim,clear,a] \w5\s[230]\i[a]\i[armcross]I do\i[au]\![anim,clear,a]n't d\i[ch]\![anim,clear,au]oubt \i[a]\![anim,clear,ch]they \i[o]\![anim,clear,a]woul\i[a]\![anim,clear,o]d bla\s[133]\i[ch]\i[armcross]me me\i[a]\![anim,clear,ch] if \i[ch]\![anim,clear,ch]I we\i[a]\![anim,clear,ch]re prese\i[ch]\![anim,clear,a]nt.\e"
					
					"\0\s[230]\i[a]\i[armcross]I liv\i[ch]\![anim,clear,a]e sur\i[o]\![anim,clear,ch]roun\i[a]\![anim,clear,o]ded b\i[ch]\![anim,clear,a]y a g\i[a]\![anim,clear,ch]ang of \f[italic,true]A\i[ch]\![anim,clear,a]rschl\i[au]\![anim,clear,ch]öcher un\i[ch]\![anim,clear,au]d Dum\i[o]\![anim,clear,ch]mköpf\i[ch]\![anim,clear,o]e\f[italic,false]. \w5\s[130]\i[au]How \i[ch]\![anim,clear,au]do y\i[o]\![anim,clear,ch]ou T\i[a]\![anim,clear,o]HINK I'\i[ch]\![anim,clear,a]m do\i[a]\![anim,clear,ch]ing?\i[ch]\![anim,clear,a]\e"
				}
			}
			if petcount > 5 || petfail > 5
			{
				"\0\s[0]\i[a]\i[armup]I'm w\i[o]\![anim,clear,a]onderin\i[ch]\![anim,clear,o]g wha\i[a]\![anim,clear,ch]t ex\i[ch]\![anim,clear,a]actl\i[a]\![anim,clear,ch]y you\i[ch]\![anim,clear,a]r mot\i[o]\![anim,clear,ch]ives \i[au]\![anim,clear,o]are,\i[ch]\![anim,clear,au] for\i[a]\![anim,clear,ch] all this\i[ch]\![anim,clear,a].\e"
				
				"\0\s[32]\i[ch]If yo\i[o]\![anim,clear,ch]u're\i[a]\![anim,clear,o] aski\i[ch]\![anim,clear,a]ng ho\i[a]\![anim,clear,ch]w I feel \i[ch]\![anim,clear,a]about\i[a]\![anim,clear,ch] your\i[au]\![anim,clear,a] beh\i[a]\![anim,clear,au]avior\i[ch]\![anim,clear,a] towa\i[a]\![anim,clear,ch]rd me\i[ch]\![anim,clear,a], \w1\s[232]\i[a]\i[armcross]I'd s\i[ch]\![anim,clear,a]ay mi\i[au]\![anim,clear,ch]ldly \i[ch]\![anim,clear,au]uncom\i[a]\![anim,clear,ch]fortable.\i[base]\![anim,clear,a]\n\n[half]\w8...\s[133]\i[a]\i[armcross]and c\i[o]\![anim,clear,a]uriou\i[ch]\![anim,clear,o]s, I\i[au]\![anim,clear,ch] suppose\i[ch]\![anim,clear,au].\e"
				
				"\0\s[62]\i[a]I'm \i[base]\![anim,clear,a]tryin\i[a]\![anim,clear,base]g to\i[ch]\![anim,clear,a] figu\i[o]\![anim,clear,ch]re o\i[a]\![anim,clear,o]ut why y\i[ch]\![anim,clear,a]ou ke\i[a]\![anim,clear,ch]ep w\i[o]\![anim,clear,a]anti\i[a]\![anim,clear,o]ng to t\i[ch]\![anim,clear,a]ouch\i[a]\![anim,clear,ch] me. \i[ch]\![anim,clear,a]\w5\s[61]\i[a]\i[armside]I've \i[o]\![anim,clear,a]done \i[au]\![anim,clear,o]nothi\i[ch]\![anim,clear,au]ng to\i[o]\![anim,clear,ch] warr\i[au]\![anim,clear,o]ant your\i[o]\![anim,clear,au] aff\i[a]\![anim,clear,o]ections,\i[ch]\![anim,clear,a] at \i[a]\![anim,clear,ch]least t\i[ch]\![anim,clear,a]hat \i[a]\![anim,clear,ch]I'm aware\i[ch]\![anim,clear,a] of...\e"
				
				"\0\s[100]\f[italic,true](He gives you an almost tired look.)\n\n[half]\w5\f[italic,false]\i[a]\![anim,clear,base]A bit confuse\i[ch]\![anim,clear,a]d, i\i[a]\![anim,clear,ch]f I mus\i[ch]\![anim,clear,a]t be\i[a]\![anim,clear,ch] honest\i[ch]\![anim,clear,a].\e"
			}
		}
	}

Select.askteam
	{
		if askedteamonce == 0
		{
			askedteamonce = 1
			"\0\s[61]\i[o]My pro\i[a]\![anim,clear,o]prietar\i[ch]\![anim,clear,a]y batch o\i[au]\![anim,clear,ch]f walki\i[ch]\![anim,clear,au]ng, \w2\i[au]\![anim,clear,ch]talki\i[ch]\![anim,clear,au]ng, \w2\i[o]\![anim,clear,ch]foolhar\i[au]\![anim,clear,o]dy organ\i[ch]\![anim,clear,au] rece\i[a]\![anim,clear,ch]ptacles? \i[ch]\![anim,clear,a]\w5\s[162]\i[a]Yes, wh\i[ch]\![anim,clear,a]at abo\i[au]\![anim,clear,ch]ut th\i[base]\![anim,clear,au]em?"
		}
		else
		{
			if askedmedonce == 1 && trusted == 0
			{
				trusted = 1
			}
			"\s[32]\i[armcross]\i[a]What is\i[ch]\![anim,clear,a] there t\i[a]\![anim,clear,ch]o say?\i[ch]\![anim,clear,a] \w6\s[133]\i[armcross]\i[a]They'r\i[o]\![anim,clear,a]e loud\i[ch]\![anim,clear,o], \w3\i[a]\![anim,clear,ch]reckles\i[ch]\![anim,clear,a]s, \w3\s[230]\i[au]often\i[ch]\![anim,clear,au] compl\i[a]\![anim,clear,ch]etely un\i[ch]\![anim,clear,a]heedi\i[a]\![anim,clear,ch]ng of\i[ch]\![anim,clear,a] any \i[a]\![anim,clear,ch]positive\s[131]\i[au] advice\i[ch]\![anim,clear,au] they're \i[a]\![anim,clear,ch]lucky eno\i[ch]\![anim,clear,a]ugh t\i[a]\![anim,clear,ch]o be given...\n\n[half]\i[ch]\![anim,clear,a]\w8\s[262]\i[hapia]Hones\i[hapich]\![anim,clear,hapia]tly, \i[hapia]\![anim,clear,hapich]I cou\i[o]\![anim,clear,hapia]ldn't\i[ch]\![anim,clear,o] have\i[hapia]\![anim,clear,ch] asked f\i[o]\![anim,clear,hapia]or mor\s[62]\i[hapia]e interes\i[hapich]\![anim,clear,hapia]ting \i[hapia]\![anim,clear,hapich]test subje\i[hapich]\![anim,clear,hapia]cts! \w6\s[160]\i[a]As patien\i[ch]\![anim,clear,a]ts on \i[o]\![anim,clear,ch]the o\i[a]\![anim,clear,o]ther \i[ch]\![anim,clear,a]hand. \w6\s[200]\i[ch]Eugh.\e"
			
			"\s[160]\i[a]They confus\i[ch]\![anim,clear,a]e me \i[a]\![anim,clear,ch]sometimes.\i[ch]\![anim,clear,a].. \w3\s[161]\i[ch]a lot\i[au]\![anim,clear,ch] of t\i[ch]\![anim,clear,au]he ti\i[a]\![anim,clear,ch]me, really\i[ch]\![anim,clear,a]. \w7\s[133]\i[armcross]\i[a]But t\i[ch]\![anim,clear,a]hey p\i[o]\![anim,clear,ch]rove th\i[a]\![anim,clear,o]emselves\i[ch]\![anim,clear,a] usef\i[a]\![anim,clear,ch]ul al\i[au]\![anim,clear,a]most \i[ch]\![anim,clear,au]more \i[a]\![anim,clear,ch]often\i[ch]\![anim,clear,a], \w2\s[232]\i[o]so I \i[ch]\![anim,clear,o]put u\i[a]\![anim,clear,ch]p with it\i[ch]\![anim,clear,a].\e"
			
			"\s[62]\i[a]I don\i[o]\![anim,clear,a]'t s\i[ch]\![anim,clear,o]uppos\i[o]\![anim,clear,ch]e you\i[ch]\![anim,clear,o] coul\i[a]\![anim,clear,ch]d summon one of the\i[ch]\![anim,clear,a]m here as well? \w6\s[61]\i[au]All o\i[ch]\![anim,clear,au]f the\i[a]\![anim,clear,ch]m, eve\i[ch]\![anim,clear,a]n?\n\n[half]\w6\s[60]\i[ch]I won\i[au]\![anim,clear,ch]der how\i[o]\![anim,clear,au] that\i[a]\![anim,clear,o] would far\i[ch]\![anim,clear,a]e in terms\i[a]\![anim,clear,ch] of re\i[ch]\![anim,clear,a]sourc\i[a]\![anim,clear,ch]e con\i[o]\![anim,clear,a]sumpt\i[a]\![anim,clear,o]ion o\i[ch]\![anim,clear,a]n thi\i[a]\![anim,clear,ch]s device.\i[ch]\![anim,clear,a] \w6\s[62]\i[hapia]\i[armside]I imagin\i[hapich]\![anim,clear,hapia]e one\i[o]\![anim,clear,hapich] huma\i[a]\![anim,clear,o]n bei\i[ch]\![anim,clear,a]ng al\i[o]\![anim,clear,ch]one i\i[ch]\![anim,clear,o]s qui\i[hapia]\![anim,clear,ch]te expensi\i[hapich]\![anim,clear,hapia]ve!\e"
			
			"\s[131]\i[base]\i[armcross]...u\i[ch]\![anim,clear,base]rgh. \w6\i[a]\![anim,clear,ch]I thi\i[ch]\![anim,clear,a]nk ab\i[a]\![anim,clear,ch]out \i[au]\![anim,clear,a]them \i[base]\![anim,clear,au]more \i[o]\![anim,clear,base]often\i[au]\![anim,clear,o] than I\i[ch]\![anim,clear,au] shou\i[o]\![anim,clear,ch]ld wh\i[a]\![anim,clear,o]ile I'm\i[ch]\![anim,clear,a] here. \w6\s[260]\i[a]\i[armcross]I sup\i[o]\![anim,clear,a]pose \i[ch]\![anim,clear,o]that'\i[a]\![anim,clear,ch]s what hap\i[ch]\![anim,clear,a]pens \i[a]\![anim,clear,ch]when yo\s[160]\i[o]u work \i[ch]\![anim,clear,o]with \i[a]\![anim,clear,ch]people too l\i[ch]\![anim,clear,a]ong.\e"
			
			"\s[232]\i[ch]\i[armcross]I'm s\i[au]\![anim,clear,ch]ure t\i[a]\![anim,clear,au]hey'r\i[ch]\![anim,clear,a]e farin\i[au]\![anim,clear,ch]g jus\i[ch]\![anim,clear,au]t as \i[a]\![anim,clear,ch]well w\i[ch]\![anim,clear,a]ithout\i[a]\![anim,clear,ch] me ba\i[o]\![anim,clear,a]ck ho\i[base]\![anim,clear,o]me. \w6\s[133]\i[ch]\i[armcross]Presumabl\i[base]\![anim,clear,ch]y.\e"
			
			"\s[62]\i[ch]You k\i[o]\![anim,clear,ch]now, \i[ch]\![anim,clear,o]it's s\i[a]\![anim,clear,ch]trang\i[ch]\![anim,clear,a]e. \w6\i[armside]Herr\i[a]\![anim,clear,ch] Demoman \i[ch]\![anim,clear,a]once me\i[o]\![anim,clear,ch]ntioned \i[a]\![anim,clear,o]a very \i[ch]\![anim,clear,a]similar \i[a]\![anim,clear,ch]situation to t\i[ch]\![anim,clear,a]his... \w6\s[60]\i[ch]he so\i[a]\![anim,clear,ch]unded\i[ch]\![anim,clear,a] quit\i[au]\![anim,clear,ch]e pleas\i[a]\![anim,clear,au]ed about\i[ch]\![anim,clear,a] it, \i[o]\![anim,clear,ch]thoug\i[ch]\![anim,clear,o]h. \w6\s[161]\i[ch]Perha\i[a]\![anim,clear,ch]ps yo\i[o]\![anim,clear,a]ur sty\i[a]\![anim,clear,o]le of \i[ch]\![anim,clear,a]expe\i[a]\![anim,clear,ch]rimentation wo\i[ch]\![anim,clear,a]uld b\i[o]\![anim,clear,ch]e mor\i[ch]\![anim,clear,o]e bef\i[a]\![anim,clear,ch]itting \i[ch]\![anim,clear,a]of hi\i[a]\![anim,clear,ch]m than\i[ch]\![anim,clear,a] me.\e"
		
		//if weekday noontime
		if (timeslot == "lunch" || timeslot == "afternoon") && (weekday > 0 && weekday <= 5)
			{
				"\s[130]\i[a]\i[armcross]Dying\i[ch]\![anim,clear,a] horr\i[au]\![anim,clear,ch]ibly \i[ch]\![anim,clear,au]witho\i[a]\![anim,clear,ch]ut me to \i[ch]\![anim,clear,a]aid o\i[a]\![anim,clear,ch]n the\i[ch]\![anim,clear,a] battle\i[a]\![anim,clear,ch]field\i[ch]\![anim,clear,a], I \i[o]\![anim,clear,ch]presu\i[base]\![anim,clear,o]me. \w6\s[162]\i[ch]They \i[o]\![anim,clear,ch]don't\i[a]\![anim,clear,o] tend\i[o]\![anim,clear,a] to a\i[a]\![anim,clear,o]ppreciat\i[ch]\![anim,clear,a]e my \i[a]\![anim,clear,ch]absence t\i[ch]\![anim,clear,a]here, yo\i[o]\![anim,clear,ch]u kno\i[base]\![anim,clear,o]w.\e"
			}
		
		if petcount >= 5
			{
				"\s[0]\i[a]Why d\i[o]\![anim,clear,a]o you\i[a]\![anim,clear,o] ask?\i[ch]\![anim,clear,a] \w5\s[100]\i[o]So you \i[base]\![anim,clear,o]can p\i[ch]\![anim,clear,base]ut yo\i[o]\![anim,clear,ch]ur ha\i[ch]\![anim,clear,o]nds a\i[au]\![anim,clear,ch]ll o\i[ch]\![anim,clear,au]ver \i[a]\![anim,clear,ch]them\i[o]\![anim,clear,a] too\i[ch]\![anim,clear,o]?\e"
				
				"\s[133]\i[a]\i[armcross]I im\i[base]\![anim,clear,a]agin\i[a]\![anim,clear,base]e a f\i[ch]\![anim,clear,a]ew o\i[a]\![anim,clear,ch]f them w\i[base]\![anim,clear,a]ould \i[o]\![anim,clear,base]be m\i[ch]\![anim,clear,o]uch b\i[a]\![anim,clear,ch]etter suited fo\i[ch]\![anim,clear,a]r thi\i[a]\![anim,clear,ch]s pos\i[ch]\![anim,clear,a]ition\i[a]\![anim,clear,ch] than I \i[base]\![anim,clear,a]am.\e"
			}
		}
	}
//*********************Advanced User Info*******************************
//Some of you may be wondering why some of these Select.options lead to another function. Why not just put the config menu coding under Select.configmenu, instead of linking to TalkConfig?
//Basically any function that's preceded with Select. is limited in its complexity and can only be called within its own .dic file in my experience. Why should you care, you ask? Well, if you're going to link to this function any other way, such as linking it in other .dic files or as a page in a menu, it needs to be a stand-alone function so it can be properly called. I'm pretty sure.
//The basic jist is this; if you're going to reuse whatever it is the option leads to, you should make it its own function. Otherwise, you can leave it in Select.option. As a rule of thumb I'd probably put any complicated stuff in its own function, then use the Select.option to call the full function as you can see above. Simple dialogue responses to a choice can stay as a Select.option though (Like "Do you like going to raves and partying? Yes/No"). Study what stays as a Select.option and what links to another Function as we go through the file.
//***********************************************************************

//--TalkConfig
//This menu allows the user to change their name and other information, as well as put in their birthday and change how often the ghost speaks. You can restructure how this looks if you want, but it's perfectly functional as is. You can of course change the dialogue though if you like.
//I commented out birthday and pronoun options, you can uncomment them if you want to add them back. They are optional! It's up to you if you want those features or not.

TalkConfig : all
{
	"\0\b[2]\_q"
	//This bit of dialogue sets up a large balloon and a quick session, like above, so all the text will appear immediately. The rest is formatted to display the information and options to change it. I wouldn't touch any of it if you don't know what you're doing.
	//I'll briefly explain the font tags I used here. \f[bold,1] turns bold on, \f[bold,0] turns it off, not unlike a <b> tag. \f[sup,1] turns superscript on (making it tiny and above the text) and \f[sup,0] turns it off. I touch on these tags in the walkthrough on SakuraScript.
	
	
	
	//"\f[bold,1]Your name:\f[bold,0] %(username) \f[sup,1](\q[Change it?,TEACHNAME])\f[sup,0]\n"
	
	
	//If you want your user to set their pronouns, you can uncomment this menu option by removing the two slashes in front. Read more on the walkthrough about commenting.
	
	//"\f[bold,1]Your pronouns:\f[bold,0] %(heshe)/%(himher)/%(hisher) \f[sup,1](\q[Change them?,TEACHPRONOUN])\f[sup,0]\n"
	
	
	//If you want your user to be able to set their birthday, you can uncomment this menu option.
	
	//"\f[bold,1]Your birthday:\f[bold,0] %(birthdayprint) \f[sup,1](\q[Change it?,TEACHBDAY])\f[sup,0]\n"
	
	
	if aitalkinterval == 0 {
		"\n\f[bold,1]Talk Rate:\f[bold,0] - silent \f[sup,1](\q[Change it,talkinter])\f[sup,0]\n\n[half]"
	} else {
		"\n\f[bold,1]Talk Rate:\f[bold,0] - %(talktime) \f[sup,1](\q[Change it,talkinter])\f[sup,0]\n\n[half]"
	}
		{
		"\![*]Enable Uninstall? (NOW : %(deleteshitai))\n\q[ON,deleteon] \q[OFF,deleteoff]\n\n[half]"
		}
		"\f[italic,true](You've had Medic running for %(passhour) hours and %(passmin) minutes."
		if petfail > 0 
		{
			if petcount > 0 
			{
				" You've pet him about "
				if petcount == 1
				{
					"1 time.)\n\n[half]\n"
				}
				else
				{
					"%(petcount) times.)\n\n[half]\n"
				}
			}
			else
			{
				" You've... well, you've TRIED to pet him about "
				if petfail == 1
				{
					"1 time.)\n\n[half]\n"
				}
				else
				{
					"%(petfail) times.)\n\n[half]\n"
				}
			}
		} 
		else
		{
			")\n\n[half]\n"
		}
		"\f[italic,false]"
	if sleeping == 1
	{
		"\![*]\q[Never mind,CANCEL]\e"
	}
	else
	{
		"\![*]\q[Back to the menu,BACKTOMENU]\e"
	}
}




